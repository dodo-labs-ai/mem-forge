{
  "name": "@memforge/admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MemForge admin UI. Runs at /v2/ beside the V1 admin-ui package until V1 is removed (ADR 0044).",
  "exports": {
    "./app": "./src/app/render.tsx",
    "./ui": "./src/ui/index.ts",
    "./patterns": "./src/patterns/index.ts",
    "./extension": "./src/app/extension/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build",
    "gen:api": "uv run --project .. python ../scripts/export_openapi.py openapi/admin.json && openapi-typescript openapi/admin.json -o src/api/schema.gen.ts",
    "check:api": "openapi-typescript openapi/admin.json -o node_modules/.tmp/schema.check.ts && diff -q src/api/schema.gen.ts node_modules/.tmp/schema.check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  }
}
