# Provider keys for the smoke scripts, scripts/provider_smoke.py and
# scripts/compose_smoke.sh. Copy this file to .env.test, which git ignores, and
# fill in the providers you have; a provider left empty is reported as skipped.
# A variable set in your shell takes precedence over this file.
#
# These keys reach only the providers you test against. Keep them separate
# from .env, which configures the MemForge you run.

# OpenRouter: one key for many generation and embedding models.
# compose_smoke.sh uses it for each model kind that names no other provider,
# unless it is run with --ollama.
OPENROUTER_API_KEY=

OPENAI_API_KEY=

# Anthropic is checked for generation only.
ANTHROPIC_API_KEY=

# provider_smoke.py --litellm-route reads the route's provider variables,
# e.g. VOYAGE_API_KEY for voyage/ routes; add them here as well.

# compose_smoke.sh reads a kind's key from <PROVIDER>_API_KEY, e.g.
# OPENAI_COMPATIBLE_API_KEY for --generation-provider openai_compatible, or
# from the variable --generation-key-env / --embedding-key-env names.
